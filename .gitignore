# Build output. Maven regenerates all of this from src/ and pom.xml, so there
# is no reason to store it - and a committed jar would be stale the moment you
# edit any source file.
target/

# IntelliJ's own project files. They contain absolute paths from THIS machine
# (your JDK location, module paths), so they are not portable and would only
# cause conflicts on another computer.
.idea/
*.iml
*.ipr
*.iws

# Local JDK/tool pointers some setups write out.
.mvn/wrapper/maven-wrapper.jar

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
